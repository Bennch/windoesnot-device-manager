# WinDoesNot fork of BigLinux Driver Manager. Preserve both upstream licenses.
pkgbase=windoesnot-device-manager
pkgname=(windoesnot-device-manager-core windoesnot-device-manager)
pkgver=0.1.0
pkgrel=3
arch=(any)
url='https://github.com/Bennch/windoesnot-device-manager'
license=(MIT GPL-3.0-or-later)
# Sources are an explicit local snapshot; never download main during a build.
source=(windoesnot-device-manager-source.tar.gz)
sha256sums=('SKIP')

package_windoesnot-device-manager-core() {
    pkgdesc='WinDoesNot hardware detection and CachyOS driver management'
    license=(GPL-3.0-or-later)
    depends=(python pacman polkit pciutils usbutils chwd)
    conflicts=(big-driver-manager-cli)
    cd "$srcdir/windoesnot-device-manager"
    install -d "$pkgdir/usr/share"
    cp -a big-driver-manager-cli/usr/share/big-driver-manager-cli "$pkgdir/usr/share/"
    install -Dm755 big-driver-manager-cli/usr/bin/big-drivers "$pkgdir/usr/bin/windoesnot-drivers"
    install -Dm644 big-driver-manager-cli/usr/share/polkit-1/actions/me.windoesnot.DeviceManager.policy "$pkgdir/usr/share/polkit-1/actions/me.windoesnot.DeviceManager.policy"
    if [[ -d big-driver-manager-cli/usr/share/locale ]]; then cp -a big-driver-manager-cli/usr/share/locale "$pkgdir/usr/share/"; fi
    install -Dm644 big-driver-manager-cli/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # No BigLinux boot services, udev auto-installers or display-manager overrides.
}

package_windoesnot-device-manager() {
    pkgdesc='WinDoesNot Device Manager, adapted from BigLinux'
    license=(MIT)
    depends=(windoesnot-device-manager-core python-gobject gtk4 libadwaita hicolor-icon-theme)
    conflicts=(biglinux-driver-manager)
    cd "$srcdir/windoesnot-device-manager"
    install -d "$pkgdir/usr/share"
    cp -a biglinux-driver-manager/usr/share/big-driver-manager "$pkgdir/usr/share/"
    if [[ -d biglinux-driver-manager/usr/share/locale ]]; then cp -a biglinux-driver-manager/usr/share/locale "$pkgdir/usr/share/"; fi
    install -Dm755 windoesnot-device-manager "$pkgdir/usr/bin/windoesnot-device-manager"
    install -Dm644 me.windoesnot.DeviceManager.desktop "$pkgdir/usr/share/applications/me.windoesnot.DeviceManager.desktop"
    install -Dm644 me.windoesnot.DeviceManager.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/me.windoesnot.DeviceManager.png"
    install -Dm644 biglinux-driver-manager/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
